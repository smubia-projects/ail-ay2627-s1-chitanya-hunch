# Hunch API: copy to .env for local runs; upload as the DOTENV repo secret for Cloud Run.

# Postgres for rooms, guesses and the demo study (Neon in production; leave empty locally to use PGlite in .game-data/).
# secret: postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=
# on: load the synthetic demo study once when the database has none (the public Insights tab needs it)
HUNCH_SEED_DEMO=on

# AI analyst (OpenAI-compatible chat completions with tools, through the club gateway)
# gateway base URL
API_BASE_URL=https://api.apiyi.com/v1
# secret: the project's key from the AI Lodge key bot
API_KEY=
# model for the analyst
MODEL_NAME=deepseek-v4-1-flash-260910

# Browser origins allowed to call the API (comma-separated): the Vercel site.
CORS_ORIGINS=http://localhost:5173

# Rate limit for analyst questions per IP (fallback; the central sheet overrides it). Unset Upstash = limiting off.
RATE_LIMIT_ASK_MAX=5
RATE_LIMIT_WINDOW_SECONDS=432000
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN come from the batch shared env.
